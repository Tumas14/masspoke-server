# Copy to .env and fill in values from Discord Developer Portal / Render

PORT=3000

# Discord Bot (Developer Portal → Bot → Token)
DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE

# Discord OAuth (Developer Portal → OAuth2)
# Application ID = Client ID (General Information)
DISCORD_CLIENT_ID=PASTE_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=PASTE_CLIENT_SECRET_HERE

# Electron loopback callback — also add this exact URL in Discord OAuth2 Redirects
DISCORD_REDIRECT_URI=http://127.0.0.1:3847/callback

# Random string for signing short-lived session codes (any long random value)
SESSION_SECRET=PASTE_RANDOM_SECRET_HERE

# Postgres connection string from Render (leave empty for local in-memory DB)
DATABASE_URL=

# Public URL of this server (localhost while developing; Render URL in production)
PUBLIC_URL=http://localhost:3000

# CORS / Socket origins (* is OK for staging)
CLIENT_ORIGIN=*
